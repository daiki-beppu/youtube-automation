---
import { getCollection } from "astro:content";
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";
import "../styles/release-notes.css";

type ReleaseKind = "main" | "extension";

interface ReleaseData {
  kind: ReleaseKind;
  released_at: Date;
  summary: string;
  title: string;
  version: string;
}

const routeByEntryId = new Map(data.routes.map((route) => [route.entryId, route.path]));
const latestRelease = (await getCollection("docs"))
  .map((entry) => {
    const release = entry.data as typeof entry.data & ReleaseData;
    return {
      ...release,
      href: routeByEntryId.get(entry.id) ?? `/${entry.id.replace(/\.mdx?$/, "")}`,
    };
  })
  .toSorted((left, right) => right.released_at.getTime() - left.released_at.getTime())[0];
const taskCards = [
  {
    description: "ツール導入、YouTube API、OAuth の準備を始める",
    href: "/getting-started/tool-setup",
    label: "はじめる",
    number: "01",
  },
  {
    description: "制作・公開・ライブ配信・手元ツールの使い方を見る",
    href: "/guides/workflow-cheatsheet",
    label: "ガイド",
    number: "02",
  },
  {
    description: "できることや制作ワークフローから skill を選ぶ",
    href: "/skills",
    label: "スキル",
    number: "03",
  },
  {
    description: "変更内容と、利用中の環境を追従させる手順を確認する",
    href: latestRelease?.href ?? "/releases",
    label: "アップデート",
    number: "04",
  },
] as const;

const kindLabel: Record<ReleaseKind, string> = {
  main: "本体",
  extension: "Chrome 拡張",
};
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("ja-JP", { dateStyle: "long", timeZone: "UTC" }).format(date);
---

<PageLayout
  site={{ title: data.config.title, description: data.config.description }}
  logo={data.config.logo}
  banner={data.config.banner}
  analytics={data.config.analytics}
  navigation={data.navigation}
  favicon={data.config.favicon}
  fontCssVars={data.fontCssVars}
  themeMode={data.config.theme.mode}
  searchEnabled={data.config.search.enabled}
  siteUrl={data.config.site}
  ogEnabled={data.config.og.enabled}
  locale={data.config.i18n?.defaultLocale}
  ui={data.ui}
  page={{
    title: "YouTube-Automation 運用ガイド",
    description: data.config.description,
  }}
>
  <main class="home-shell">
    <header class="home-hero">
      <p class="release-eyebrow">YouTube-Automation 運用ガイド</p>
      <h1>何をしたいですか？</h1>
      <p>導入から日々の制作、公開後の運用まで、目的に合う公式ドキュメントを案内します。</p>
      <button class="home-search" data-home-search type="button">
        <svg aria-hidden="true" height="20" viewBox="0 0 24 24" width="20">
          <circle cx="11" cy="11" fill="none" r="7" stroke="currentColor" stroke-width="2"></circle>
          <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
        </svg>
        <span>ドキュメントを検索</span>
        <kbd>⌘ K</kbd>
      </button>
    </header>

    <nav aria-label="目的から選ぶ" class="home-task-grid">
      {taskCards.map((card) => (
        <a class="home-task-card" href={card.href}>
          <span aria-hidden="true">{card.number}</span>
          <h2>{card.label}</h2>
          <p>{card.description}</p>
          <strong aria-hidden="true">開く →</strong>
        </a>
      ))}
    </nav>

    {latestRelease && (
      <section class="home-latest" data-home-section="latest-release">
        <header>
          <div>
            <p class="release-eyebrow">latest release</p>
            <h2>最新のアップデート</h2>
          </div>
          <a href={latestRelease.href}>すべて見る →</a>
        </header>
        <a class="release-card" href={latestRelease.href}>
          <div class="release-meta">
            <span class:list={["release-kind", `release-kind--${latestRelease.kind}`]}>
              {kindLabel[latestRelease.kind]}
            </span>
            <time datetime={latestRelease.released_at.toISOString()}>
              {formatDate(latestRelease.released_at)}
            </time>
          </div>
          <h2>{latestRelease.version}</h2>
          <p>{latestRelease.title}</p>
          <span class="release-link" aria-hidden="true">{latestRelease.summary} <span>→</span></span>
        </a>
      </section>
    )}
  </main>
  <script>
    document.querySelector("[data-home-search]")?.addEventListener("click", () => {
      const trigger = document.querySelector<HTMLButtonElement>("[data-blume-search-open]");
      trigger?.click();
    });
  </script>
</PageLayout>
