{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "experiment-entry.schema.json",
  "title": "Experiment entry",
  "description": "data/experiments.jsonl の単一変数実験契約。schema_version 1 は pending 登録と judged 判定を表す。登録は append-only、判定時は status と judged_date / result_vpd / verdict だけを一体更新する。",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "registered_date",
    "lever",
    "change",
    "hypothesis_source",
    "target",
    "baseline_vpd",
    "baseline_basis",
    "judge_after_days",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "registered_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "lever": {
      "$ref": "insights-entry.schema.json#/properties/lever"
    },
    "change": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "hypothesis_source": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "baseline_vpd": {
      "type": "number",
      "minimum": 0
    },
    "baseline_basis": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "judge_after_days": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": ["pending", "judged"]
    },
    "judged_date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "result_vpd": {
      "type": "number",
      "minimum": 0
    },
    "verdict": {
      "enum": ["improved", "no_change", "worse"]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "judged"}}},
      "then": {"required": ["judged_date", "result_vpd", "verdict"]},
      "else": {
        "not": {
          "anyOf": [
            {"required": ["judged_date"]},
            {"required": ["result_vpd"]},
            {"required": ["verdict"]}
          ]
        }
      }
    }
  ]
}
