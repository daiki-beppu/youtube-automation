{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "music-prompt.schema.json",
  "title": "音楽プロンプト",
  "description": "music が生成する Suno / Lyria prompt の JSON 正本。HTML は prompt 承認 gate の表示に使う。",
  "type": "object",
  "required": ["schema_version", "generated_at", "engine", "collection_id", "provenance", "entries"],
  "properties": {
    "schema_version": {"title": "Schema version", "const": 1, "x-view": {"order": 0}},
    "generated_at": {"title": "生成日時", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "x-view": {"order": 1}},
    "engine": {"title": "Music engine", "enum": ["suno", "lyria"], "x-view": {"order": 2}},
    "collection_id": {"title": "Collection", "type": "string", "minLength": 1, "x-view": {"order": 3}},
    "provenance": {"title": "Provenance", "$ref": "#/definitions/provenance", "x-view": {"order": 10}},
    "entries": {"title": "Prompt entries", "type": "array", "minItems": 1, "items": {"$ref": "#/definitions/entry"}, "x-view": {"order": 20, "presentation": "table"}}
  },
  "additionalProperties": true,
  "definitions": {
    "provenance": {
      "type": "object",
      "required": ["producer", "source_paths"],
      "properties": {
        "producer": {"const": "music"},
        "source_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "insight_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "review": {
      "type": "object",
      "required": ["verify_status", "semantic_status", "notes"],
      "properties": {
        "verify_status": {"enum": ["pass", "fail"]},
        "semantic_status": {"enum": ["pass", "fail"]},
        "notes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": ["name", "style", "lyrics", "options", "track_role", "review"],
      "properties": {
        "name": {"title": "Entry name", "type": "string", "minLength": 1},
        "title": {"title": "Song title", "type": "string", "minLength": 1},
        "style": {"title": "Style / prompt", "type": "string", "minLength": 1},
        "lyrics": {"title": "Lyrics", "type": "string"},
        "options": {"title": "Generation options", "type": "object", "additionalProperties": true},
        "track_role": {"title": "Track role", "type": "string", "minLength": 1},
        "review": {"title": "Review result", "$ref": "#/definitions/review"}
      },
      "additionalProperties": true
    }
  }
}
