{
  "permissions": {
    "allow": [
      "Agent",
      "Bash(uv run yt-upload-auto*)",
      "Bash(uv run yt-upload-collection*)",
      "Bash(uv run yt-upload-shorts*)"
    ],
    "deny": [
      "Read(auth/client_secrets.json)",
      "Read(auth/token.json)",
      "Read(.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/skills/automation/references/guard_secret_edit.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Task|Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" yt-progress-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run yt-session-start",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Task|Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --project \"$CLAUDE_PROJECT_DIR\" yt-progress-hook"
          }
        ]
      }
    ]
  }
}
